{
    "version": "2.0.0",
    "tasks": [
    {
        "type": "cppbuild",
        "label": "C/C++: gcc.exe 生成活动文件",
        "command": "D:/application/mingw64/bin/gcc.exe",
        "args": [
            "-fdiagnostics-color=always",
            "-g",
            "${file}",
            "-o",
            "${fileDirname}\\coin\\${fileBasenameNoExtension}.exe"
        ],
        "options": {
            "cwd": "D:/application/mingw64/bin"
        },
        "problemMatcher": [
            "$gcc"
        ],
        "group": "build",
        "detail": "D:/application/mingw64/bin/gcc.exe"
    }
    ]
}